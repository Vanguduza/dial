{
  "schemaVersion": 1,
  "profileVersion": "2026-08-28.1",
  "purpose": "Machine-readable approved plugin profile for DIAL coding harnesses. Required plugins are installed and verified automatically at AI session startup when the harness permits it.",
  "policy": {
    "autoInstallRequired": true,
    "autoInstallOptional": false,
    "preferOfficialOrVendorMaintained": true,
    "allowUnapprovedSubstitutes": false,
    "discoverExactIdentifierBeforeInstall": true,
    "oauthOrAdminApprovalRequiresUserAction": true,
    "batchRestartOnceAfterInstall": true,
    "neverStoreSecretsInReceipt": true,
    "projectTruthPrecedence": true,
    "receiptPath": ".dial/state/plugin-bootstrap.json",
    "unavailablePluginPolicy": "record_pending_unavailable_and_continue_without_inventing_a_substitute",
    "installationFailurePolicy": "retry_once_then_record_pending_with_exact_reason"
  },
  "claudeCode": {
