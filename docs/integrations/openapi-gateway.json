{
  "openapi": "3.0.3",
  "info": {
    "title": "DIAL Gateway — integration surface (skeleton)",
    "version": "0.1.0",
    "description": "S134 skeleton for API-key drop-in readiness. Documents health + inbound webhook shapes. Never includes secret values. Health JSON note SoR: buildIntegrationsHealthNote (info.x-dial-sor.healthNote); docs pointer INTEGRATIONS_NOTE_BUILDER_SOR_DOCS (info.x-dial-sor.noteBuilderDocs). Webhooks: signature verify + claimProcessedEvent idempotency (info.x-dial-sor.webhookSignature / webhookIdempotency). Authoritative eng behaviour remains Pack/adapters; this is a contract outline for vendors/ops.",
    "x-dial-sor": {
      "probes": "apps/gateway-web/src/lib/integrationsReadiness.ts#INTEGRATION_PROBE_KEYS",
      "envGroups": "apps/gateway-web/src/lib/integrationsReadiness.ts#INTEGRATION_ENV_GROUPS",
      "envGroupLabels": "apps/gateway-web/src/lib/integrationsReadiness.ts#INTEGRATION_ENV_GROUP_LABELS",
      "healthNote": "apps/gateway-web/src/lib/integrationsReadiness.ts#buildIntegrationsHealthNote",
      "healthNoteUiMax": "apps/gateway-web/src/lib/integrationsReadiness.ts#INTEGRATIONS_HEALTH_NOTE_UI_MAX",
      "noteBuilderHint": "apps/gateway-web/src/lib/integrationsReadiness.ts#INTEGRATIONS_NOTE_BUILDER_SOR_HINT_ID",
      "noteBuilderDocs": "apps/gateway-web/src/lib/integrationsReadiness.ts#INTEGRATIONS_NOTE_BUILDER_SOR_DOCS",
      "readyVsGroupsHint": "apps/gateway-web/src/lib/integrationsReadiness.ts#INTEGRATIONS_READY_VS_GROUPS_HINT_ID",
      "docs": "docs/integrations/README.md",
      "readyVsGroups": "docs/integrations/README.md#ready-meaning-s194",
      "webhookSignature": "Adapter verifySignature / HMAC before mutate (D-47)",
      "webhookIdempotency": "packages/shared/src/idempotency.ts#claimProcessedEvent → processed_events"
    }
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Local gateway-web"
    }
  ],
  "tags": [
    { "name": "health" },
    {
      "name": "webhooks",
      "description": "S196 — inbound PSP/WA/FDMS callbacks. SoR: verify signature (or vendor verify) then claimProcessedEvent / processed_events idempotency before mutate. Opaque body never documents secret values. Fail-closed 503 when sandbox/live misconfigured."
    },
    { "name": "admin" }
  ],
  "paths": {
    "/api/health/integrations": {
      "get": {
        "tags": ["health"],
        "summary": "Integration readiness (mode, ready, probes, groups)",
        "operationId": "getIntegrationsHealth",
        "responses": {
          "200": {
            "description": "Readiness snapshot — never echoes secrets",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IntegrationsHealth"
                }
              }
            }
          }
        }
      }
    },
    "/api/webhooks/paynow": {
      "post": {
        "tags": ["webhooks"],
        "summary": "Paynow SHA512 result notification",
        "operationId": "webhookPaynow",
        "parameters": [
          {
            "name": "Hash",
            "in": "header",
            "required": false,
            "schema": { "type": "string" },
            "description": "Paynow hash (also validated from body fields)"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/WebhookOpaqueBody" }
            },
            "application/x-www-form-urlencoded": {
              "schema": { "$ref": "#/components/schemas/WebhookOpaqueBody" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Accepted or duplicate idempotent (signature verified)"
          },
          "401": { "description": "Bad signature" },
          "503": { "description": "Fail-closed (sandbox/live misconfig)" }
        }
      }
    },
    "/api/webhooks/contipay": {
      "post": {
        "tags": ["webhooks"],
        "summary": "ContiPay HMAC webhook",
        "operationId": "webhookContipay",
        "parameters": [
          {
            "name": "x-contipay-signature",
            "in": "header",
            "required": false,
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/WebhookOpaqueBody" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Accepted or duplicate idempotent (signature verified)"
          },
          "401": { "description": "Bad signature" },
          "503": { "description": "Fail-closed (sandbox/live misconfig)" }
        }
      }
    },
    "/api/webhooks/ecocash": {
      "post": {
        "tags": ["webhooks"],
        "summary": "EcoCash HMAC webhook",
        "operationId": "webhookEcocash",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/WebhookOpaqueBody" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Accepted or duplicate idempotent (signature verified)"
          },
          "401": { "description": "Bad signature" },
          "503": { "description": "Fail-closed (sandbox/live misconfig)" }
        }
      }
    },
    "/api/webhooks/paypal": {
      "post": {
        "tags": ["webhooks"],
        "summary": "PayPal webhook verify",
        "operationId": "webhookPaypal",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/WebhookOpaqueBody" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Accepted or duplicate idempotent (signature verified)"
          },
          "401": { "description": "Bad signature / verify failed" },
          "503": { "description": "Fail-closed (sandbox/live misconfig)" }
        }
      }
    },
    "/api/webhooks/escrow": {
      "post": {
        "tags": ["webhooks"],
        "summary": "Escrow hold/capture HMAC",
        "operationId": "webhookEscrow",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/WebhookOpaqueBody" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Accepted or duplicate idempotent (signature verified)"
          },
          "401": { "description": "Bad signature" },
          "503": { "description": "Fail-closed (sandbox/live misconfig)" }
        }
      }
    },
    "/api/webhooks/fdms": {
      "post": {
        "tags": ["webhooks"],
        "summary": "FDMS Gateway acknowledge / submit callback",
        "operationId": "webhookFdms",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/WebhookOpaqueBody" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Accepted or duplicate idempotent (signature verified)"
          },
          "401": { "description": "Bad signature" },
          "503": { "description": "Fail-closed (sandbox/live misconfig)" }
        }
      }
    },
    "/api/webhooks/whatsapp": {
      "get": {
        "tags": ["webhooks"],
        "summary": "Meta hub challenge",
        "operationId": "webhookWhatsappChallenge",
        "parameters": [
          {
            "name": "hub.mode",
            "in": "query",
            "schema": { "type": "string" }
          },
          {
            "name": "hub.verify_token",
            "in": "query",
            "schema": { "type": "string" }
          },
          {
            "name": "hub.challenge",
            "in": "query",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": { "description": "Challenge echo" },
          "403": { "description": "Verify token mismatch" }
        }
      },
      "post": {
        "tags": ["webhooks"],
        "summary": "Meta Cloud API inbound (HMAC)",
        "operationId": "webhookWhatsapp",
        "parameters": [
          {
            "name": "x-hub-signature-256",
            "in": "header",
            "required": false,
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/WebhookOpaqueBody" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Accepted or duplicate idempotent (signature verified)"
          },
          "401": { "description": "Bad HMAC" },
          "503": { "description": "Fail-closed (sandbox/live misconfig)" }
        }
      }
    },
    "/api/webhooks/psp": {
      "post": {
        "tags": ["webhooks"],
        "summary": "Legacy generic PSP/escrow shim",
        "operationId": "webhookPspLegacy",
        "deprecated": true,
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/WebhookOpaqueBody" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Accepted or duplicate idempotent (signature verified)"
          },
          "401": { "description": "Bad signature" },
          "503": { "description": "Fail-closed (sandbox/live misconfig)" }
        }
      }
    },
    "/api/admin/fdms/day": {
      "get": {
        "tags": ["admin"],
        "summary": "Fiscal day state (fail-closed INTERNAL_API_SECRET)",
        "operationId": "adminFdmsDayGet",
        "security": [{ "InternalApiSecret": [] }],
        "responses": {
          "200": { "description": "Fiscal day snapshot" },
          "401": { "description": "Missing/invalid internal secret" }
        }
      },
      "post": {
        "tags": ["admin"],
        "summary": "Open/close fiscal day",
        "operationId": "adminFdmsDayPost",
        "security": [{ "InternalApiSecret": [] }],
        "responses": {
          "200": { "description": "Day action result" },
          "401": { "description": "Missing/invalid internal secret" }
        }
      }
    },
    "/api/admin/money/outbox": {
      "get": {
        "tags": ["admin"],
        "summary": "Money outbox depth",
        "operationId": "adminMoneyOutboxGet",
        "security": [{ "InternalApiSecret": [] }],
        "responses": {
          "200": { "description": "Outbox depth" },
          "401": { "description": "Missing/invalid internal secret" }
        }
      },
      "post": {
        "tags": ["admin"],
        "summary": "Drain money outbox",
        "operationId": "adminMoneyOutboxDrain",
        "security": [{ "InternalApiSecret": [] }],
        "responses": {
          "200": { "description": "Drain result" },
          "401": { "description": "Missing/invalid internal secret" }
        }
      }
    },
    "/api/admin/fx/daily-zig": {
      "get": {
        "tags": ["admin"],
        "summary": "Active Daily ZiG rate + audit (D-57; fail-closed INTERNAL_API_SECRET)",
        "operationId": "adminFxDailyZigGet",
        "security": [{ "InternalApiSecret": [] }],
        "responses": {
          "200": { "description": "Active rate + audit rows" },
          "401": { "description": "Missing/invalid internal secret" },
          "503": { "description": "INTERNAL_API_SECRET unset — fail closed" }
        }
      },
      "post": {
        "tags": ["admin"],
        "summary": "Set Daily ZiG rate (audited; integer zigMinorPerUsd)",
        "operationId": "adminFxDailyZigPost",
        "security": [{ "InternalApiSecret": [] }],
        "responses": {
          "200": { "description": "New active rate" },
          "400": { "description": "Invalid body" },
          "401": { "description": "Missing/invalid internal secret" },
          "503": { "description": "INTERNAL_API_SECRET unset — fail closed" }
        }
      }
    },
    "/api/openapi": {
      "get": {
        "tags": ["health"],
        "summary": "Serve this OpenAPI skeleton document",
        "operationId": "getOpenApiSkeleton",
        "responses": {
          "200": {
            "description": "OpenAPI 3.0 JSON",
            "content": {
              "application/json": {
                "schema": { "type": "object" }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "InternalApiSecret": {
        "type": "apiKey",
        "in": "header",
        "name": "x-internal-secret",
        "description": "INTERNAL_API_SECRET — never expose in browser bundles"
      }
    },
    "schemas": {
      "IntegrationsHealth": {
        "type": "object",
        "required": ["ok", "ready", "mode", "probes", "groups"],
        "properties": {
          "ok": { "type": "boolean" },
          "ready": {
            "type": "boolean",
            "description": "S194 — integrationsReady(probes) only; independent of groups[].configured (fixture may be ready=true with incomplete groups — S193)"
          },
          "mode": {
            "type": "string",
            "enum": ["fixture", "sandbox", "live"]
          },
          "probes": {
            "$ref": "#/components/schemas/IntegrationsProbes"
          },
          "groups": {
            "type": "array",
            "description": "S194 — env presence snapshots only; configured≠ready. Names of missing keys, never secret values.",
            "items": {
              "type": "object",
              "required": [
                "label",
                "configured",
                "missing",
                "presentCount",
                "requiredCount"
              ],
              "properties": {
                "label": {
                  "type": "string",
                  "enum": [
                    "whatsapp",
                    "paynow",
                    "contipay",
                    "ecocash",
                    "paypal",
                    "escrow",
                    "fdms",
                    "meili",
                    "litellm",
                    "maps",
                    "temporal",
                    "redis",
                    "internal"
                  ]
                },
                "configured": {
                  "type": "boolean",
                  "description": "All required env keys for this group are non-empty"
                },
                "missing": {
                  "type": "array",
                  "items": { "type": "string" },
                  "description": "Unset key names only — never values"
                },
                "presentCount": { "type": "integer" },
                "requiredCount": { "type": "integer" }
              }
            }
          },
          "note": {
            "type": "string",
            "description": "Built by buildIntegrationsHealthNote(mode): mode guidance plus ordered groups labels=… from INTEGRATION_ENV_GROUP_LABELS (S151/S152/S163/S165). Admin UIs truncate via truncateIntegrationsHealthNote / INTEGRATIONS_HEALTH_NOTE_UI_MAX (S154/S157); full note remains in JSON."
          }
        }
      },
      "IntegrationsProbes": {
        "type": "object",
        "description": "S137 — boolean readiness probes aggregated into ready",
        "required": [
          "temporal",
          "litellm",
          "maps",
          "fdms",
          "meili",
          "queues",
          "whatsapp",
          "psp",
          "internal"
        ],
        "additionalProperties": false,
        "properties": {
          "temporal": { "type": "boolean" },
          "litellm": { "type": "boolean" },
          "maps": { "type": "boolean" },
          "fdms": { "type": "boolean" },
          "meili": { "type": "boolean" },
          "queues": { "type": "boolean" },
          "whatsapp": { "type": "boolean" },
          "psp": { "type": "boolean" },
          "internal": { "type": "boolean" }
        }
      },
      "WebhookOpaqueBody": {
        "type": "object",
        "description": "Vendor payload — verified by adapter signature before mutate; idempotent via processed_events (S196 SoR: info.x-dial-sor.webhookSignature + webhookIdempotency)",
        "additionalProperties": true
      }
    }
  }
}
