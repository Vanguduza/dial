# DIAL env example — Pack §6 names only; never commit real values
# Classification: public = safe in browser (NEXT_PUBLIC_/VITE_); secret = server/workers only
#
# Integration mode (eng):
#   DIAL_INTEGRATION_MODE=fixture   # default CI — recorded fixtures, no outbound HTTP
#   DIAL_INTEGRATION_MODE=sandbox   # use vendor sandbox URLs when keys present
#   DIAL_INTEGRATION_MODE=live      # production endpoints — fail closed if secrets missing
#
# Health readiness (S132/S150/S161/S168/S177/S186/S200/S211): GET /api/health/integrations returns `groups` + `probes`/`ready`.
# `ready` = integrationsReady(probes) only — not all groups[].configured (OpenAPI readyVsGroups / S194).
# Fixture (S211): ready=true even when every group has configured=false (no secrets required).
# Checklist: docs/integrations/README.md — fill keys below before sandbox/live.
# SoR: INTEGRATION_ENV_GROUPS + INTEGRATION_ENV_GROUP_LABELS
#   (apps/gateway-web/src/lib/integrationsReadiness.ts).
# Health JSON `note` via buildIntegrationsHealthNote (OpenAPI info.x-dial-sor.healthNote).
# Admin UI truncates health `note` via INTEGRATIONS_HEALTH_NOTE_UI_MAX
#   (OpenAPI info.x-dial-sor.healthNoteUiMax).
# Admin note-builder cross-link test id: note-builder-sor-hint
#   (INTEGRATIONS_NOTE_BUILDER_SOR_HINT_ID / INTEGRATIONS_NOTE_BUILDER_SOR_DOCS).
# OpenAPI info.x-dial-sor.noteBuilderDocs → INTEGRATIONS_NOTE_BUILDER_SOR_DOCS.
# OpenAPI info.x-dial-sor.readyVsGroupsHint → INTEGRATIONS_READY_VS_GROUPS_HINT_ID (S208).
# Group labels ↔ keys: whatsapp | paynow | contipay | ecocash | paypal | escrow | fdms |
#   meili | litellm | maps | temporal | redis | internal | supabase
#
# Sandbox vendor HTTP (optional — default sandbox is inline/fail-closed shapes):
#   ECOCASH_SANDBOX_HTTP=1   # real EcoCash sandbox HTTP when ECOCASH_* set
#   WA_SANDBOX_HTTP=1        # real Graph HTTP when WHATSAPP_* set
#   FDMS_SANDBOX_HTTP=1      # real FDMS_BASE_URL HTTP when FDMS_* set
# Key-drop-in: .cursor/rules/dial-key-drop-in.mdc + docs/integrations/key-drop-in-readiness.md
#
# G2 EcoCash founder exception (eng sequencing only — not live/production):
#   Documented pretend Pack §6 ECOCASH_* in local .env (gitignored) with
#   ECOCASH_SANDBOX_HTTP unset → EcoCashDirectAdapter eco_sb_* path.
#   Ops: docs/ops/ecocash-pretend-sandbox.md — never commit values.

DIAL_INTEGRATION_MODE=fixture

# Local compose defaults (docker compose up -d redis meilisearch):
# REDIS_URL=redis://127.0.0.1:6379
# MEILI_HOST=http://127.0.0.1:7700
# MEILI_MASTER_KEY=dev_master_key_change_me
# TEMPORAL_ADDRESS=127.0.0.1:7233   # after: docker compose --profile temporal up -d
#
# Production-like local stack (docker-compose.prod.yml): `pnpm secrets:local` writes
# .env.local with generated Postgres/GoTrue/PostgREST/Meili/internal credentials, then
# `pnpm stack:up` builds images, boots the stack and applies supabase/migrations.
# Runbook: docs/ops/local-production-environment.md

# --- public ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_GATEWAY_URL=
NEXT_PUBLIC_SPARE_URL=
NEXT_PUBLIC_TECH_URL=
NEXT_PUBLIC_SUPPLIER_URL=
NEXT_PUBLIC_ADMIN_URL=
NEXT_PUBLIC_MEILI_HOST=
NEXT_PUBLIC_MEILI_SEARCH_KEY=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# Optional Phase 1/2 dogfood Auth (names only — never commit values):
# DIAL_SANDBOX_AUTH_EMAIL=
# DIAL_SANDBOX_AUTH_PASSWORD=

# --- secret: core (health group: redis, temporal, internal) ---
SUPABASE_SERVICE_ROLE_KEY=
# Server-side override for durable REST writes (defaults to NEXT_PUBLIC_SUPABASE_URL).
# The local stack sets this to the in-network gateway; hosted Supabase can leave it blank.
SUPABASE_URL=
DATABASE_URL=
REDIS_URL=
TEMPORAL_ADDRESS=127.0.0.1:7233
TEMPORAL_NAMESPACE=dial
N8N_BASE_URL=
N8N_API_KEY=
INTERNAL_API_SECRET=
# Absolute gateway origin used by native apps (staging/prod) and share links.
# Native builds fail closed while empty; see docs/ops/phase3-release-signing.md.
DIAL_GATEWAY_BASE_URL=

# --- Meilisearch (health group: meili) ---
MEILI_HOST=http://127.0.0.1:7700
MEILI_MASTER_KEY=
MEILI_SPARE_INDEX=spare_offers_v1
MEILI_GROCERY_INDEX=grocery_offers_v1

# --- AI (LiteLLM → Gemini only; D-61) (health group: litellm) ---
LITELLM_BASE_URL=
LITELLM_API_KEY=
GEMINI_API_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
PROMPTFOO_CONFIG=packages/ai/evals/promptfooconfig.yaml

# --- Payments (D-43) (health groups: paynow, contipay, ecocash, paypal, escrow) ---
PAYNOW_INTEGRATION_ID=
PAYNOW_INTEGRATION_KEY=
PAYNOW_RESULT_URL=https://api.example/webhooks/paynow
PAYNOW_RETURN_URL=https://dialaspare.co.zw/checkout/return
PSP_ESCROW_BASE_URL=
PSP_ESCROW_API_KEY=
PSP_WEBHOOK_SECRET=

CONTIPAY_API_KEY=
CONTIPAY_API_SECRET=
CONTIPAY_MERCHANT_ID=
CONTIPAY_MODE=dev
CONTIPAY_WEBHOOK_URL=
CONTIPAY_SUCCESS_URL=
CONTIPAY_CANCEL_URL=

# EcoCash (Pack §6). Pretend local values OK for G2 eng-exception; portal keys for live.
# Leave ECOCASH_SANDBOX_HTTP unset for eco_sb_* pretend path; set =1 only with portal sandbox keys.
ECOCASH_API_KEY=
ECOCASH_MERCHANT_CODE=
ECOCASH_ENVIRONMENT=sandbox
ECOCASH_WEBHOOK_SECRET=
# ECOCASH_SANDBOX_HTTP=

PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
PAYPAL_WEBHOOK_ID=

COD_MAX_ORDER_MINOR_USD=
COD_MAX_ORDER_MINOR_ZWG=
COD_COURIER_FLOAT_LIMIT_MINOR=
COD_BAN_FAILURE_THRESHOLD=3

